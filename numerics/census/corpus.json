    {"id": "M05", "kind": "corpus", "family": "honeycomb", "domain": "L", "weight": "1/2", "domain_type": "torus", "G": "sqrt", "u": "3 + 2*c1 + 2*c2 + 2*(c1*c2 + s1*s2)"},
